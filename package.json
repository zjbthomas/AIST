{
  "name": "arknights-is-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "predev": "node scripts/sync-prts.mjs",
    "sync:prts": "node scripts/sync-prts.mjs --force",
    "sync:stages": "node scripts/sync-prts.mjs --force --stages-only",
    "cache:prts-assets": "node scripts/cache-prts-assets.mjs",
    "sync:prts:cached": "npm run sync:prts && npm run cache:prts-assets"
  },
  "dependencies": {
    "lucide-react": "latest",
    "pinyin-pro": "latest",
    "react": "latest",
    "react-dom": "latest",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
